# BharatLangTech AI Environment Configuration

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Hardware & Acceleration
# cuda | mps | cpu. Leave unset to auto-detect (CUDA, then Apple MPS, then CPU).
# DEVICE=cpu
FALLBACK_DEVICE=cpu

# Speech Recognition (ASR)
# Options: faster-whisper-small, faster-whisper-base, indicconformer-mr,
#          indicwhisper-medium-mr, whisper-small-marathi-steja, assemblyai (cloud, needs a key)
# The last two load CT2 conversions from ASR_CT2_DIR (default <repo>/models/ct2/<name>).
# Best measured (2026-11-12, RESPIN mr test): indicwhisper-medium-mr 26.9% WER vs small 101.6%.
ASR_ACTIVE_MODEL=faster-whisper-small
# Optional cloud ASR: set ASR_ACTIVE_MODEL=assemblyai and a key. Sends audio to AssemblyAI
# (not offline). Without a key the engine is not offered and the app falls back to local.
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com        # EU: https://api.eu.assemblyai.com
# ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2  # Marathi is routed to universal-2
# ASSEMBLYAI_TIMEOUT_SEC=120
# ASSEMBLYAI_DELETE_AFTER=true                           # delete the transcript at AssemblyAI after reading it
# ASR_CT2_DIR=C:\dev\Bharatlang\models\ct2
ASR_FALLBACK_MODEL=faster-whisper-base
WHISPER_COMPUTE_TYPE=int8
# cpu | cuda. On an NVIDIA GPU use WHISPER_DEVICE=cuda with WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_DEVICE=cpu
# cuda | mps | cpu (default: auto-detect). cpu saves VRAM; query embedding is cheap.
# EMBEDDING_DEVICE=cpu

# Which LLM answers: ollama (local daemon, below) or bedrock (Amazon Bedrock, cloud)
LLM_PROVIDER=ollama

# Amazon Bedrock (used when LLM_PROVIDER=bedrock). Sends the question and the retrieved
# excerpts to AWS. Credentials come from the standard AWS chain (EC2 instance role, AWS
# profile or env vars); never put AWS keys in this file.
# BEDROCK_REGION=ap-southeast-2
# BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
# BEDROCK_MAX_TOKENS=600
# BEDROCK_TIMEOUT_SECONDS=60

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=600
# Disable hidden reasoning for thinking models (qwen3.x) so the token budget goes to the answer
OLLAMA_THINK=false
# Office GPU server (RTX 3060 Ti) via SSH tunnel:
#   ssh -N -L 11435:127.0.0.1:11434 office-via-dell
# then set OLLAMA_BASE_URL=http://localhost:11435 and OLLAMA_MODEL=qwen3.5:9b
LLM_CONTEXT_CHUNKS=4
LLM_CONTEXT_CHARS_PER_CHUNK=600

# Translation
# Options: nllb-distilled-600M, indictrans2, ollama-assisted
TRANSLATION_ACTIVE_ENGINE=nllb-distilled-600M
HF_TOKEN=

# RAG & Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=100

# Text-to-Speech (TTS)
TTS_VOICE=mr-IN-AarohiNeural
TTS_FALLBACK_VOICE=mr-IN-ManoharNeural

# Storage Paths
DATABASE_URL=sqlite:///./backend/data/bharatlangtech.db
DOCUMENTS_DIR=./backend/data/documents
INDEXES_DIR=./backend/data/indexes
AUDIO_DIR=./backend/data/audio
EVALUATIONS_DIR=./backend/data/evaluations

# Retention & Privacy
AUDIO_RETENTION_DAYS=7
ANONYMIZE_LOGS=true

